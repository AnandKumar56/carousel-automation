{# IMAGE-CAPTION / image_annotated - full-bleed image with a scrim.

   No safe-area inset at the root: the image reaches all four edges and the text
   sits on a gradient scrim over the bottom. This is the family that most visibly
   breaks the old silhouette, because there is no inset content rectangle at all.

   The image is optional by design - a labelled placeholder is better than failing
   a whole batch when a reference image could not be fetched. Only data URIs are
   accepted; render.js blocks network requests inside the page, so an http image
   would silently render as a broken box. #}
<div class="lay L-image on-scrim" style="--headline-len: {{ view.headline_len }};">

  {% if view.image.present %}
    <div class="img-plate" style="background-image: {{ view.image.css | safe }};"></div>
  {% else %}
    <div class="img-plate is-placeholder"></div>
    <div class="img-placeholder-note">{{ view.image.note }}</div>
  {% endif %}

  <div class="img-top region">
    {% if slide.eyebrow %}<div class="sec-eyebrow img-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
  </div>

  <div class="img-scrim region">
    <h2 class="img-headline">{{ slide.headline }}</h2>
    {% if slide.caption %}<p class="img-caption">{{ slide.caption }}</p>{% endif %}
    {% include 'partials/meta.njk' %}
  </div>

</div>

<style>
  /* Over an image the accent may not clear the background, so the eyebrow gets a
     solid chip rather than relying on colour contrast alone. */
  .L-image .img-eyebrow {
    display: inline-block;
    background: var(--bg);
    color: var(--accent);
    padding: 12px 20px;
    border-radius: 8px;
  }
  .L-image .img-scrim .slide-meta { padding: 0; margin-top: 10px; }
</style>
