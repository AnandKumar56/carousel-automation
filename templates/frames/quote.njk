{# QUOTE / quote_evidence - the quote IS the canvas.

   An oversized quotation mark anchors the composition top-left and the quote runs
   large through a centred 1fr region, with the speaker in an accent-ruled block at
   the bottom. The old version used the same eyebrow-headline-block skeleton as
   every other frame, so a quote slide was structurally indistinguishable from a
   headline slide.

   Type size scales on quote length: a 60-character quote should be enormous, a
   220-character one merely large. #}
<div class="lay L-quote" style="--quote-len: {{ view.quote_len }};">

  <div class="quote-mark region" aria-hidden="true">&ldquo;</div>

  <div class="quote-stage region">
    <blockquote class="quote-text">{{ slide.quote }}</blockquote>
  </div>

  <div class="quote-foot region">
    {% if slide.attribution %}
      <div class="quote-attrib">
        <div class="quote-name">{{ slide.attribution }}</div>
        {% if slide.attributionRole %}<div class="quote-role">{{ slide.attributionRole }}</div>{% endif %}
      </div>
    {% endif %}
    {% include 'partials/meta.njk' %}
  </div>

</div>

<style>
  /* The meta block sits inside quote-foot, which already pads the bottom. */
  .L-quote .quote-foot .slide-meta { padding: 0; }
</style>
