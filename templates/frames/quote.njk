{# QUOTE - a single attributed statement. Use for a claim from a person or an
   official company statement. Deliberately sparse so the words carry it. #}
<div class="inner quote">

  {% if slide.eyebrow %}
    <div class="eyebrow">{{ slide.eyebrow }}</div>
  {% endif %}

  <div class="spacer"></div>

  <div class="quote-body" style="--quote-len: {{ (slide.quote | default('')) | length }};">
    <div class="quote-mark">&ldquo;</div>
    <blockquote class="quote-text">{{ slide.quote }}</blockquote>
    {% if slide.attribution %}
      <div class="attribution">
        <span class="attr-rule"></span>
        <div class="attr-text">
          <div class="attr-name">{{ slide.attribution }}</div>
          {% if slide.attributionRole %}<div class="attr-role">{{ slide.attributionRole }}</div>{% endif %}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="spacer"></div>

  <div class="footer">
    <span class="brand">{{ brand }}</span>
    {% if totalSlides > 1 %}<span class="pager">{{ slideNumber }} / {{ totalSlides }}</span>{% endif %}
  </div>

</div>

<style>
  .quote-body { display: flex; flex-direction: column; gap: 12px; }
  .quote-mark {
    font-family: var(--font-display);
    font-size: 180px;
    line-height: 0.6;
    color: var(--accent);
    opacity: 0.5;
  }
  .quote-text {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--fg-strong);
    max-width: 860px;
    /* Shrinks as the quote lengthens so long statements still fit. */
    font-size: clamp(44px, calc(104px - var(--quote-len) * 0.24px), 76px);
  }
  .attribution { display: flex; align-items: center; gap: 24px; margin-top: 36px; }
  .attr-rule { width: 72px; height: 5px; background: var(--accent); border-radius: 3px; flex: 0 0 auto; }
  .attr-name { font-size: 34px; font-weight: 600; color: var(--fg); }
  .attr-role { font-family: var(--font-mono); font-size: 24px; letter-spacing: 0.06em; color: var(--fg-faint); margin-top: 4px; }
</style>
