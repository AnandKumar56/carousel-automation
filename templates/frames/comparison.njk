{# COMPARISON / split_comparison - two sides in genuine opposition.

   The old version stacked two rounded cards inside the safe area, which read as a
   list of two things rather than a split. Here the body is a true 50/50 grid with
   a divider running edge to edge, and the right side carries an accent wash
   because it is the side being argued for.

   Values are optional: a comparison may be two figures, two lists, or two short
   passages. #}
<div class="lay L-split" style="--headline-len: {{ view.headline_len }};">

  <div class="split-head region">
    {% if slide.eyebrow %}<div class="sec-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
    <h2 class="sec-headline">{{ slide.headline }}</h2>
  </div>

  <div class="split-body region">
    <div class="split-side region{% if slide.leftValue %} has-value{% endif %}" style="--value-len: {{ view.left_len }};">
      <div class="split-label">{{ slide.leftLabel | default('Before') }}</div>
      {% if slide.leftValue %}<div class="split-value">{{ slide.leftValue }}</div>{% endif %}
      {% if slide.leftItems %}
        <ul class="split-items">
          {% for i in slide.leftItems %}<li>{{ i }}</li>{% endfor %}
        </ul>
      {% elif slide.leftText %}
        <p class="split-text">{{ slide.leftText }}</p>
      {% endif %}
    </div>

    <div class="split-divider"></div>

    <div class="split-side is-focus region{% if slide.rightValue %} has-value{% endif %}" style="--value-len: {{ view.right_len }};">
      <div class="split-label">{{ slide.rightLabel | default('After') }}</div>
      {% if slide.rightValue %}<div class="split-value">{{ slide.rightValue }}</div>{% endif %}
      {% if slide.rightItems %}
        <ul class="split-items">
          {% for i in slide.rightItems %}<li>{{ i }}</li>{% endfor %}
        </ul>
      {% elif slide.rightText %}
        <p class="split-text">{{ slide.rightText }}</p>
      {% endif %}
    </div>
  </div>

  {% include 'partials/meta.njk' %}

</div>
