{# STAT / metric_cards - one figure owning the canvas.

   Routed through the same metric-card layout as `stat-grid` (as a one-card grid)
   rather than having its own skeleton, so the two frames cannot drift apart in
   type scale or spacing.

   The figure's size scales on its string length, so "3,400" and "40" are each set
   as large as they can be instead of both being set at one compromise size. #}
{% set metric = view.metrics[0] %}
<div class="lay L-metrics n-1">

  <div class="metrics-head region">
    {% if slide.eyebrow %}<div class="sec-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
  </div>

  <div class="metrics-grid region">
    <div class="metric-card is-lead" style="--value-len: {{ metric.value_len }};">
      <div class="metric-value">{{ metric.value }}</div>
      {% if metric.unit %}<div class="metric-unit">{{ metric.unit }}</div>{% endif %}
      <div class="stat-rule"></div>
      {% if metric.label %}<div class="metric-label">{{ metric.label }}</div>{% endif %}
      {% if view.support %}<p class="stat-support">{{ view.support }}</p>{% endif %}
    </div>
  </div>

  {% include 'partials/meta.njk' %}

</div>

<style>
  /* A single hero figure needs no card chrome - the number IS the slide. Border
     and fill are dropped so nothing competes with it. */
  .L-metrics.n-1 .metric-card {
    background: transparent;
    border: none;
    padding: 0;
    justify-content: center;
    gap: 16px;
    align-items: flex-start;
  }
  .L-metrics.n-1 .metric-unit { font-size: 40px; }
  /* A rule between the figure and its label gives the block three tiers instead of
     two, so the mass reads as a composed stack rather than a number with a caption
     stranded in the middle of the canvas. */
  .stat-rule {
    width: 132px;
    height: 8px;
    border-radius: 4px;
    background: var(--accent);
    margin: 14px 0 6px 0;
  }
  .stat-support {
    font-size: 30px;
    line-height: 1.38;
    color: var(--fg-muted);
    max-width: 780px;
    margin-top: 4px;
  }
</style>
