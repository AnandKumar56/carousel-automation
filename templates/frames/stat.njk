{# STAT - one number as the hero. Use for a single headline figure with a short
   label and optional supporting line. The number scales down as it lengthens. #}
<div class="inner stat">

  {% if slide.eyebrow %}
    <div class="eyebrow">{{ slide.eyebrow }}</div>
  {% endif %}

  <div class="spacer"></div>

  <div class="stat-block" style="--stat-len: {{ (slide.value | default('')) | length }};">
    <div class="stat-value">{{ slide.value }}</div>
    {% if slide.unit %}<div class="stat-unit">{{ slide.unit }}</div>{% endif %}
    <div class="rule"></div>
    {% if slide.label %}<div class="stat-label">{{ slide.label }}</div>{% endif %}
    {% if slide.body %}<p class="body-text stat-body">{{ slide.body }}</p>{% endif %}
  </div>

  <div class="spacer"></div>

  <div class="footer">
    <span class="brand">{{ brand }}</span>
    {% if totalSlides > 1 %}
      <span class="pager">{{ slideNumber }} / {{ totalSlides }}</span>
    {% endif %}
  </div>

</div>

<style>
  .stat-block { display: flex; flex-direction: column; gap: 26px; }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    font-size: clamp(120px, calc(300px - var(--stat-len) * 12px), 250px);
  }
  .stat-unit {
    font-family: var(--font-mono);
    font-size: 40px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-top: -8px;
  }
  .stat-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    line-height: 1.16;
    color: var(--fg-strong);
    max-width: 820px;
  }
  .stat-body { margin-top: 6px; max-width: 780px; }
</style>
