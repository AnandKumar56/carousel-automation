{# NUMBERED-STEPS / diagram_explainer - a process as a connected flow.

   The old version was a vertical list of numbered rows, which is a list that
   happens to have numbers on it. Here each step is a bordered band with an arrow
   between bands, so the sequence is carried by the geometry - a reader sees a flow
   before reading a word. The final step is accent-bordered because it is the
   outcome. #}
{% set n = view.steps | length %}
<div class="lay L-diagram steps-{{ n }}" style="--headline-len: {{ view.headline_len }};">

  <div class="dg-head region">
    {% if slide.eyebrow %}<div class="sec-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
    <h2 class="sec-headline">{{ slide.headline }}</h2>
  </div>

  <div class="dg-flow region">
    {% for s in view.steps %}
      <div class="dg-step{% if s.is_last %} is-last{% endif %}">
        <div class="dg-num">{{ loop.index }}</div>
        <div class="dg-body">
          <div class="dg-title">{{ s.title }}</div>
          {% if s.detail %}<div class="dg-detail">{{ s.detail }}</div>{% endif %}
        </div>
      </div>
      {% if not loop.last %}
        <div class="dg-arrow">&darr;</div>
      {% endif %}
    {% endfor %}
  </div>

  {% include 'partials/meta.njk' %}

</div>
