{# BULLET-LIST - a headline plus 2-5 short points. Font size steps down as the
   list grows so five bullets still fit inside 1080x1350 without overflow. #}
{% set n = (slide.bullets | default([])) | length %}
<div class="inner bullets bullets-{{ n }}">

  {% if slide.eyebrow %}
    <div class="eyebrow">{{ slide.eyebrow }}</div>
  {% endif %}

  <h2 class="headline headline-sm">{{ slide.headline }}</h2>

  {% if slide.subheadline %}
    <p class="subheadline sub-sm">{{ slide.subheadline }}</p>
  {% endif %}

  <ul class="bullet-list">
    {% for b in slide.bullets %}
      <li class="bullet">
        <span class="dot"></span>
        <span class="bullet-text">{{ b }}</span>
      </li>
    {% endfor %}
  </ul>

  <div class="spacer"></div>

  <div class="footer">
    <span class="brand">{{ brand }}</span>
    {% if totalSlides > 1 %}
      <span class="pager">{{ slideNumber }} / {{ totalSlides }}</span>
    {% endif %}
  </div>

</div>

<style>
  .bullets .headline-sm {
    font-size: clamp(52px, calc(112px - var(--headline-len) * 0.75px), 82px);
    max-width: 840px;
  }
  .bullets .sub-sm { font-size: 34px; margin-top: 20px; max-width: 800px; }

  .bullet-list { list-style: none; margin-top: 56px; display: flex; flex-direction: column; gap: 34px; }
  .bullet { display: flex; align-items: flex-start; gap: 26px; }
  .dot {
    flex: 0 0 auto;
    width: 20px; height: 20px;
    margin-top: 14px;
    border-radius: 50%;
    background: var(--accent);
  }
  .bullet-text {
    font-size: 38px;
    line-height: 1.34;
    color: var(--fg);
  }

  /* Tighten as the list lengthens. */
  .bullets-4 .bullet-list, .bullets-5 .bullet-list { gap: 26px; }
  .bullets-4 .bullet-text { font-size: 34px; }
  .bullets-5 .bullet-text { font-size: 31px; }
  .bullets-5 .dot { width: 16px; height: 16px; margin-top: 12px; }
</style>
