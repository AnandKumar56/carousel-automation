{# BULLET-LIST / evidence_list - claims with their own attribution.

   THE DEFECT THIS FIXES: the old bullet-list rendered unattributed assertions -
   a dot, a sentence, nothing else - in a feed whose whole value is reporting
   figures. Here each row can carry its own figure and its own source, so a reader
   can see which publication supports which claim.

   Rows are separated by rules and the list is vertically centred in a 1fr region,
   which removes the trailing void the audit measured. A claim resting only on a
   tier-4 source is labelled on the slide rather than dropped: dropping it loses
   real reporting, printing it unmarked beside a Reuters figure implies equal
   standing.

   Plain-string bullets still work; the object form is what unlocks attribution. #}
{% set n = view.evidence | length %}
<div class="lay L-evidence items-{{ n }}" style="--headline-len: {{ view.headline_len }};">

  <div class="ev-head region">
    {% if slide.eyebrow %}<div class="sec-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
    <h2 class="sec-headline">{{ slide.headline }}</h2>
    {% if slide.subheadline %}<p class="sec-sub">{{ slide.subheadline }}</p>{% endif %}
  </div>

  <ul class="ev-list region">
    {% for e in view.evidence %}
      <li class="ev-item">
        {% if e.figure %}
          <div class="ev-figure">{{ e.figure }}</div>
        {% else %}
          <div class="ev-marker"></div>
        {% endif %}
        <div class="ev-body">
          <div class="ev-text">{{ e.text }}</div>
          {% if e.source %}
            <div class="ev-source{% if e.weak %} is-weak{% endif %}">{{ e.source }}{% if e.weak %} · unverified{% endif %}</div>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>

  {% include 'partials/meta.njk' %}

</div>
