{# TIMELINE - dated events in order, 2-4 entries. Use for rollout history,
   announcement sequences, or "what happened when". #}
{% set n = (slide.events | default([])) | length %}
<div class="inner timeline timeline-{{ n }}">

  {% if slide.eyebrow %}
    <div class="eyebrow">{{ slide.eyebrow }}</div>
  {% endif %}

  <h2 class="headline headline-sm">{{ slide.headline }}</h2>

  <div class="tl-list">
    {% for e in slide.events %}
      <div class="tl-item">
        <div class="tl-marker">
          <span class="tl-dot"></span>
          {% if not loop.last %}<span class="tl-line"></span>{% endif %}
        </div>
        <div class="tl-body">
          <div class="tl-date">{{ e.date }}</div>
          <div class="tl-text">{{ e.text }}</div>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="spacer"></div>

  <div class="footer">
    <span class="brand">{{ brand }}</span>
    {% if totalSlides > 1 %}<span class="pager">{{ slideNumber }} / {{ totalSlides }}</span>{% endif %}
  </div>

</div>

<style>
  .timeline .headline-sm {
    font-size: clamp(48px, calc(102px - var(--headline-len) * 0.7px), 76px);
    max-width: 840px;
  }
  .tl-list { margin-top: 54px; display: flex; flex-direction: column; }
  .tl-item { display: flex; gap: 28px; }
  .tl-marker { flex: 0 0 auto; width: 24px; display: flex; flex-direction: column; align-items: center; }
  .tl-dot {
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--accent);
    margin-top: 12px;
    flex: 0 0 auto;
  }
  .tl-line { width: 4px; flex: 1; background: var(--card-border); margin: 8px 0; }
  .tl-body { padding-bottom: 38px; }
  .tl-date {
    font-family: var(--font-mono);
    font-size: 26px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .tl-text { font-size: 36px; line-height: 1.3; color: var(--fg); margin-top: 10px; max-width: 780px; }

  .timeline-4 .tl-text { font-size: 31px; }
  .timeline-4 .tl-body { padding-bottom: 28px; }
</style>
