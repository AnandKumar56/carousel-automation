{# TIMELINE / timeline_scaled - dated events with PROPORTIONAL spacing.

   THE DEFECT THIS FIXES: the old frame listed events at equal intervals, which
   misrepresents pace. Three events in March and one in November drawn evenly
   implies steady progress when the actual story is the gap. Here each connector's
   flex-grow is the real elapsed time (computed in slidemodel.js), and the gap is
   labelled, so a five-month pause looks like a five-month pause.

   When any date cannot be parsed the whole rail falls back to even spacing rather
   than being proportional for some gaps and arbitrary for others - and it says so
   in the render warnings. #}
{% set n = view.timeline.events | length %}
<div class="lay L-timeline events-{{ n }}" style="--headline-len: {{ view.headline_len }};">

  <div class="tl-head region">
    {% if slide.eyebrow %}<div class="sec-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
    <h2 class="sec-headline">{{ slide.headline }}</h2>
  </div>

  <div class="tl-rail region">
    {% for e in view.timeline.events %}
      <div class="tl-event{% if e.is_key %} is-key{% endif %}">
        <div class="tl-marker"><span class="tl-dot"></span></div>
        <div class="tl-body">
          <div class="tl-date">{{ e.date }}</div>
          <div class="tl-text">{{ e.text }}</div>
          {% if e.source %}<div class="tl-source">{{ e.source }}</div>{% endif %}
        </div>
      </div>

      {% if not loop.last %}
        {% set gap = view.timeline.gaps[loop.index0] %}
        <div class="tl-gap" style="flex: {{ gap.flex }} 1 0;">
          <div class="tl-connector"></div>
          {% if gap.elapsed %}<div class="tl-elapsed">{{ gap.elapsed }}</div>{% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% include 'partials/meta.njk' %}

</div>
