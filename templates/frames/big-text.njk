{# BIG-TEXT / editorial_hero (centre-anchored).

   Shares the hero family with `cover` rather than reimplementing a near-identical
   skeleton, but uses `at-centre` so the statement floats dead centre with space
   above AND below it. That is a different mass distribution from the cover's
   bottom-anchored block - in the first pass both were bottom-anchored and the two
   slides were structurally indistinguishable, which defeated the point of the
   rebuild.

   No subheadline and no swipe row: a single statement should not be qualified. #}
<div class="lay L-hero at-centre" style="--headline-len: {{ view.headline_len }};">

  <div class="hero-rail"></div>

  <div class="hero-eyebrow region">
    {% if slide.eyebrow %}<div class="sec-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
  </div>

  <div class="hero-body region">
    <h1 class="hero-headline">{{ slide.text }}</h1>
    {% if slide.footnote %}<p class="bt-footnote">{{ slide.footnote }}</p>{% endif %}
  </div>

  <div class="hero-swipe region"></div>

  {% include 'partials/meta.njk' %}

</div>

<style>
  .L-hero .hero-swipe { padding: 0; height: 0; }
  .bt-footnote {
    font-size: 27px;
    line-height: 1.34;
    color: var(--fg-muted);
    max-width: 780px;
    border-left: 5px solid var(--accent);
    padding-left: 22px;
  }
</style>
