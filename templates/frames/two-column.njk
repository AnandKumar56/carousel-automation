{# TWO-COLUMN / split_comparison - two facets of one thing.

   Shares the split layout with `comparison` but is NOT adversarial framing: no
   accent wash on either side, and both column heads are treated equally. Use this
   for "the hardware / what it enables", where the two lists are complementary
   rather than opposed. #}
<div class="lay L-split is-neutral" style="--headline-len: {{ view.headline_len }};">

  <div class="split-head region">
    {% if slide.eyebrow %}<div class="sec-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
    <h2 class="sec-headline">{{ slide.headline }}</h2>
  </div>

  <div class="split-body region">
    <div class="split-side region">
      <div class="split-label">{{ slide.leftLabel }}</div>
      <ul class="split-items">
        {% for i in slide.leftItems %}<li>{{ i }}</li>{% endfor %}
      </ul>
    </div>

    <div class="split-divider"></div>

    <div class="split-side region">
      <div class="split-label is-accent">{{ slide.rightLabel }}</div>
      <ul class="split-items">
        {% for i in slide.rightItems %}<li>{{ i }}</li>{% endfor %}
      </ul>
    </div>
  </div>

  {% include 'partials/meta.njk' %}

</div>

<style>
  /* Both sides read as peers, so the right column is distinguished only by its
     label colour rather than by a filled background. */
  .L-split.is-neutral .split-label.is-accent { color: var(--accent); }
</style>
