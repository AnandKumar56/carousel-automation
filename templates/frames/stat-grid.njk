{# STAT-GRID - 2 to 4 numbers together. Use when several figures matter equally,
   rather than one hero stat. 2 renders as one row, 3-4 as a 2x2 grid. #}
{% set n = (slide.stats | default([])) | length %}
<div class="inner statgrid statgrid-{{ n }}">

  {% if slide.eyebrow %}
    <div class="eyebrow">{{ slide.eyebrow }}</div>
  {% endif %}

  {% if slide.headline %}
    <h2 class="headline headline-sm">{{ slide.headline }}</h2>
  {% endif %}

  <div class="sg-grid">
    {% for s in slide.stats %}
      <div class="sg-cell">
        <div class="sg-value">{{ s.value }}</div>
        {% if s.unit %}<div class="sg-unit">{{ s.unit }}</div>{% endif %}
        <div class="sg-label">{{ s.label }}</div>
      </div>
    {% endfor %}
  </div>

  <div class="spacer"></div>

  <div class="footer">
    <span class="brand">{{ brand }}</span>
    {% if totalSlides > 1 %}<span class="pager">{{ slideNumber }} / {{ totalSlides }}</span>{% endif %}
  </div>

</div>

<style>
  .statgrid .headline-sm {
    font-size: clamp(46px, calc(96px - var(--headline-len) * 0.66px), 70px);
    max-width: 840px;
  }
  .sg-grid { margin-top: 52px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .statgrid-2 .sg-grid { grid-template-columns: 1fr 1fr; }
  .statgrid-3 .sg-grid .sg-cell:first-child { grid-column: 1 / -1; }

  .sg-cell {
    background: var(--card-bg);
    border: 2px solid var(--card-border);
    border-radius: 20px;
    padding: 34px 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sg-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 84px;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .sg-unit {
    font-family: var(--font-mono);
    font-size: 24px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .sg-label { font-size: 28px; line-height: 1.3; color: var(--fg); margin-top: 8px; }

  .statgrid-2 .sg-value { font-size: 108px; }
  .statgrid-2 .sg-label { font-size: 32px; }
  .statgrid-4 .sg-value { font-size: 74px; }
</style>
