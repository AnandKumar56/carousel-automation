{# STAT-GRID / metric_cards - 2 to 4 figures that matter together.

   THE DEFECT THIS FIXES: the old version gave "3,400" and "40" identical visual
   weight in identical cards, so a slide with one headline figure and three
   supporting ones read as four equal facts. Here one card is the lead - larger
   type, accent fill, and in the 3-card case a full-width row - so the layout
   itself states which number the slide is about.

   Per-card source badges appear only when the figures genuinely come from
   different publications; when they all share one source the footer says it once.

   Card count drives the grid shape via the n-N class (see layouts.css). #}
{% set n = view.metrics | length %}
<div class="lay L-metrics n-{{ n }}">

  <div class="metrics-head region">
    {% if slide.eyebrow %}<div class="sec-eyebrow">{{ slide.eyebrow }}</div>{% endif %}
    {% if slide.headline %}<h2 class="sec-headline">{{ slide.headline }}</h2>{% endif %}
  </div>

  <div class="metrics-grid region">
    {% for m in view.metrics %}
      <div class="metric-card{% if m.is_lead %} is-lead{% endif %}" style="--value-len: {{ m.value_len }};">
        <div class="metric-value">{{ m.value }}</div>
        {% if m.unit %}<div class="metric-unit">{{ m.unit }}</div>{% endif %}
        <div class="metric-label">{{ m.label }}</div>
        {% if view.show_metric_sources and m.source %}
          <div class="metric-source">{{ m.source }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% include 'partials/meta.njk' %}

</div>

<style>
  /* Headline is held back here: on this layout the figures are the subject and the
     headline only frames them. */
  .L-metrics .sec-headline {
    font-size: clamp(42px, calc(88px - var(--headline-len) * 0.6px), 64px);
    margin-top: 18px;
  }
</style>
