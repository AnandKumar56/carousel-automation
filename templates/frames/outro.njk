{# OUTRO / conclusion_cta - the close.

   The only centred, symmetric layout in the set, so the last slide reads as an
   ending rather than as one more content slide. It also carries the full source
   manifest: the one place in a carousel where a reader can audit every figure at
   once, which matters more here than anywhere because the individual slides only
   cite what they use. #}
<div class="lay L-outro" style="--headline-len: {{ view.headline_len }};">

  <div class="outro-stage region">
    <div class="outro-rule"></div>
    <h2 class="outro-headline">{{ slide.headline }}</h2>
    {% if slide.subheadline %}<p class="outro-sub">{{ slide.subheadline }}</p>{% endif %}
    {% if slide.cta %}<div class="outro-cta">{{ slide.cta }}</div>{% endif %}
  </div>

  <div class="outro-manifest region">
    {% if view.manifest | length %}
      <div class="manifest-title">Sources</div>
      {# Joined with a literal separator and left to autoescape. Marking this
         `safe` in order to use an HTML entity would also unescape the source
         names, which are external input. #}
      <div class="manifest-names">{{ view.manifest | join('  ·  ') }}</div>
    {% endif %}
  </div>

  {% include 'partials/meta.njk' %}

</div>
